<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= rollLeaf(roll.rel_path) %></title>
  <link rel="stylesheet" href="/static/style.css">
  <style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #eef1f5; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; }

  /* ── Top bar ── */
  .s-topbar {
    position: sticky; top: 0; z-index: 100;
    background: #1a3a5c;
    color: #fff;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 10px 20px;
    flex-wrap: wrap;
  }
  .s-topbar-left { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; min-width: 0; }
  .s-topbar-title {
    font-size: 1rem; font-weight: 700; letter-spacing: 0.02em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .s-topbar-meta { font-size: 0.8rem; color: rgba(255,255,255,0.65); white-space: nowrap; }
  .s-topbar-right { display: flex; gap: 8px; align-items: center; flex-shrink: 0; }

  .s-btn-dl {
    display: inline-flex; align-items: center; gap: 7px;
    background: #2e6da4; color: #fff;
    border: none; border-radius: 4px;
    padding: 8px 16px;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.05em;
    cursor: pointer; text-decoration: none; white-space: nowrap;
    transition: background 0.15s;
  }
  .s-btn-dl:hover { background: #245a8c; }
  .s-btn-dl-secondary {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,255,255,0.15); color: #fff;
    border: 1px solid rgba(255,255,255,0.3); border-radius: 4px;
    padding: 8px 16px;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.05em;
    cursor: pointer; text-decoration: none; white-space: nowrap;
    transition: background 0.15s;
  }
  .s-btn-dl-secondary:hover { background: rgba(255,255,255,0.28); }

  /* ── Content ── */
  .s-content { padding: 16px 0 40px; }

  /* ── Section (one per album — just one here) ── */
  .s-section { margin-bottom: 20px; }

  .s-section-bar {
    background: #1a3a5c; color: #fff;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 8px 16px; flex-wrap: wrap;
    margin-bottom: 1px;
  }
  .s-section-title {
    font-size: 0.85rem; font-weight: 700; letter-spacing: 0.02em;
    display: flex; align-items: center; gap: 8px;
  }
  .s-section-count {
    background: rgba(255,255,255,0.15); border-radius: 3px;
    padding: 1px 8px; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.04em;
  }
  .s-section-actions { display: flex; gap: 8px; }

  .s-btn-folder {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,0.15); color: #fff;
    border: 1px solid rgba(255,255,255,0.3); border-radius: 3px;
    padding: 5px 12px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em;
    cursor: pointer; text-decoration: none; white-space: nowrap;
    transition: background 0.15s;
  }
  .s-btn-folder:hover { background: rgba(255,255,255,0.28); }

  .s-btn-see-more {
    display: inline-flex; align-items: center; gap: 4px;
    background: rgba(255,255,255,0.12); color: #fff;
    border: 1px solid rgba(255,255,255,0.25); border-radius: 3px;
    padding: 5px 10px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em;
    cursor: pointer; transition: background 0.15s;
  }
  .s-btn-see-more:hover { background: rgba(255,255,255,0.25); }
  .s-btn-see-more.hidden { display: none; }

  /* ── Photo grid ── */
  .s-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: #d0d8e4;
  }

  /* ── Photo card ── */
  .s-card {
    background: #fff;
    display: flex; flex-direction: column;
    text-decoration: none; color: inherit;
    transition: box-shadow 0.15s;
    position: relative;
    cursor: pointer;
  }
  .s-card:hover { box-shadow: inset 0 0 0 2px #2e6da4; z-index: 1; }

  .s-card-img-wrap {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #dde3ea;
  }
  .s-card-img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.2s ease;
  }
  .s-card:hover .s-card-img { transform: scale(1.03); }

  .s-card-play {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    pointer-events: none;
  }
  .s-card-play-circle {
    width: 40px; height: 40px; border-radius: 50%;
    background: rgba(0,0,0,0.55);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 1rem; padding-left: 3px;
  }

  .s-card-foot {
    padding: 7px 10px;
    display: flex; align-items: center; justify-content: space-between; gap: 6px;
    border-top: 1px solid #edf0f4;
    min-height: 36px;
  }
  .s-card-name {
    font-size: 0.75rem; color: #2d3e4e;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    flex: 1;
  }
  .s-card-size {
    display: inline-flex; align-items: center; gap: 4px;
    background: #2e6da4; color: #fff;
    border-radius: 999px; padding: 2px 8px;
    font-size: 0.68rem; font-weight: 700; white-space: nowrap; flex-shrink: 0;
  }

  /* ── Hidden cards ── */
  .s-card-hidden { display: none; }

  /* ── Show-more card ── */
  .s-more-card {
    background: #e8edf3;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 8px; cursor: pointer; border: none;
    aspect-ratio: 4/3;
    transition: background 0.15s;
    width: 100%;
    padding: 0;
  }
  .s-more-card:hover { background: #dce4ee; }
  .s-more-plus { font-size: 3rem; color: #8a9bac; line-height: 1; display: block; }
  .s-more-label { font-size: 0.72rem; font-weight: 700; color: #6b7c8d; letter-spacing: 0.07em; text-transform: uppercase; display: block; }

  /* ── Footer ── */
  .s-footer { text-align: center; padding: 28px 16px; font-size: 0.75rem; color: #8a9bac; letter-spacing: 0.05em; }

  @media (max-width: 900px) {
    .s-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    .s-grid { grid-template-columns: repeat(2, 1fr); }
    .s-topbar { padding: 10px 14px; }
    .s-content { padding: 10px 0 32px; }
  }
  </style>
</head>
<body>

<%
  const PREVIEW = 3;
  function fmtSize(b) {
    if (!b) return '';
    if (b >= 1e9) return (b/1e9).toFixed(1)+'GB';
    if (b >= 1e6) return (b/1e6).toFixed(1)+'MB';
    if (b >= 1e3) return Math.round(b/1e3)+'KB';
    return b+'B';
  }
  const totalSize = photos.reduce((s,p) => s + (p.file_size||0), 0);
  const albumTitle = rollLeaf(roll.rel_path);
  const meta = [roll.date_label || roll.year, roll.film_stock].filter(Boolean).join(' · ');
%>

<!-- Top bar -->
<div class="s-topbar">
  <div class="s-topbar-left">
    <span class="s-topbar-title"><%= albumTitle %></span>
    <% if (meta) { %><span class="s-topbar-meta"><%= meta %></span><% } %>
  </div>
  <div class="s-topbar-right">
    <a class="s-btn-dl-secondary" href="/share/<%= token %>/download?type=original">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
      ORIGINAL
    </a>
    <a class="s-btn-dl" href="/share/<%= token %>/download">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
      COMPRESSED<% if (totalSize) { %> (<%= fmtSize(totalSize) %>)<% } %>
    </a>
  </div>
</div>

<div class="s-content">
<% if (!photos.length) { %>
  <p style="text-align:center;padding:60px 24px;color:#6b7c8d">No photos in this album.</p>
<% } else { %>
  <div class="s-section">

    <!-- Section bar -->
    <div class="s-section-bar">
      <div class="s-section-title">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        <%= albumTitle %>
        <span class="s-section-count"><%= photos.length %> photo<%= photos.length !== 1 ? 's' : '' %></span>
      </div>
      <div class="s-section-actions">
        <a class="s-btn-folder" href="/share/<%= token %>/download?type=original">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
          ORIGINAL
        </a>
        <a class="s-btn-folder" href="/share/<%= token %>/download">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
          COMPRESSED
        </a>
        <% if (photos.length > PREVIEW) { %>
        <button class="s-btn-see-more" id="see-more-btn" onclick="showAll()">
          SEE MORE ▾
        </button>
        <% } %>
      </div>
    </div>

    <!-- Grid: all photos rendered, extras hidden until expanded -->
    <div class="s-grid" id="photo-grid">
      <% for (let i = 0; i < photos.length; i++) {
           const p = photos[i];
           const isVid = /\.(mp4|mov|avi|mkv|m4v|webm)$/i.test(p.file_path || '');
           const hidden = (photos.length > PREVIEW) && (i >= PREVIEW);
      %>
      <a class="s-card<%= hidden ? ' s-card-hidden' : '' %>" href="/share/<%= token %>/photo/<%= p.id %>">
        <div class="s-card-img-wrap">
          <img class="s-card-img" src="/share/<%= token %>/thumb/<%= p.id %>" alt="<%= p.filename %>" loading="lazy">
          <% if (isVid) { %>
          <div class="s-card-play"><div class="s-card-play-circle">&#9654;</div></div>
          <% } %>
        </div>
        <div class="s-card-foot">
          <span class="s-card-name"><%= p.filename %></span>
          <% if (p.file_size) { %>
          <span class="s-card-size">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
            <%= fmtSize(p.file_size) %>
          </span>
          <% } %>
        </div>
      </a>
      <% } %>

      <% if (photos.length > PREVIEW) { %>
      <button class="s-more-card" id="more-card" onclick="showAll()">
        <div class="s-more-plus">+</div>
        <div class="s-more-label">Show <%= photos.length - PREVIEW %> more</div>
      </button>
      <% } %>
    </div>

  </div>
<% } %>
</div>

<div class="s-footer">PHOTO ARCHIVE &nbsp;·&nbsp; alzfilm.ca</div>

<script>
function showAll() {
  // Reveal all hidden photo cards
  document.querySelectorAll('.s-card-hidden').forEach(el => {
    el.classList.remove('s-card-hidden');
  });
  // Remove the show-more placeholder card
  const moreCard = document.getElementById('more-card');
  if (moreCard) moreCard.remove();
  // Hide the SEE MORE button in the section bar
  const seeMoreBtn = document.getElementById('see-more-btn');
  if (seeMoreBtn) seeMoreBtn.style.display = 'none';
}
</script>

</body>
</html>
