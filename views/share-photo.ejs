<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= photo.filename %> — <%= rollLeaf ? rollLeaf(roll.rel_path) : 'Shared Album' %></title>
  <link rel="stylesheet" href="/static/style.css">
  <style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: #f5f5f2;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    display: flex; flex-direction: column; min-height: 100vh;
  }

  /* ── Nav bar ── */
  .sp-nav {
    background: #1a3a5c;
    color: #fff;
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; padding: 10px 20px;
    position: sticky; top: 0; z-index: 100;
    flex-wrap: wrap;
  }
  .sp-back {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.82rem; color: rgba(255,255,255,0.8);
    text-decoration: none; white-space: nowrap;
    transition: color 0.15s;
  }
  .sp-back:hover { color: #fff; }
  .sp-back svg { flex-shrink: 0; }

  .sp-center {
    display: flex; align-items: center; gap: 10px;
    font-size: 0.82rem; color: rgba(255,255,255,0.75);
  }
  .sp-counter { font-weight: 600; color: #fff; }
  .sp-arrow {
    display: inline-flex; align-items: center; gap: 4px;
    background: rgba(255,255,255,0.15); color: #fff;
    border: 1px solid rgba(255,255,255,0.25); border-radius: 3px;
    padding: 4px 10px; font-size: 0.75rem; font-weight: 600;
    text-decoration: none; white-space: nowrap;
    transition: background 0.15s;
  }
  .sp-arrow:hover { background: rgba(255,255,255,0.28); }
  .sp-arrow-ghost { opacity: 0; pointer-events: none; padding: 4px 10px; font-size: 0.75rem; }

  .sp-right { display: flex; gap: 8px; align-items: center; }
  .sp-rotate {
    background: rgba(255,255,255,0.12); color: #fff;
    border: 1px solid rgba(255,255,255,0.25); border-radius: 3px;
    padding: 5px 9px; font-size: 1rem; cursor: pointer;
    transition: background 0.15s; line-height: 1;
  }
  .sp-rotate:hover { background: rgba(255,255,255,0.25); }
  .sp-dl {
    display: inline-flex; align-items: center; gap: 6px;
    background: #2e6da4; color: #fff;
    border: none; border-radius: 3px;
    padding: 6px 14px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em;
    text-decoration: none; white-space: nowrap;
    transition: background 0.15s;
  }
  .sp-dl:hover { background: #245a8c; }
  .sp-dl-secondary {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,0.15); color: #fff;
    border: 1px solid rgba(255,255,255,0.3); border-radius: 3px;
    padding: 6px 14px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em;
    text-decoration: none; white-space: nowrap;
    transition: background 0.15s;
  }
  .sp-dl-secondary:hover { background: rgba(255,255,255,0.28); }

  /* ── Photo area ── */
  .sp-body {
    flex: 1;
    display: flex; align-items: center; justify-content: center;
    padding: 24px;
  }
  .sp-img {
    max-width: 100%;
    max-height: calc(100vh - 120px);
    width: auto; height: auto;
    display: block;
    object-fit: contain;
    transition: transform 0.3s ease;
    transform-origin: center center;
    box-shadow: 0 4px 32px rgba(0,0,0,0.15);
  }
  .sp-video-wrap { position: relative; width: 100%; max-width: 1200px; }
  .sp-video {
    width: 100%; max-height: calc(100vh - 120px);
    display: block; border-radius: 2px;
    box-shadow: 0 4px 32px rgba(0,0,0,0.15);
  }

  /* ── Processing overlay ── */
  .sp-overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.75); color: #fff;
    display: none; flex-direction: column;
    align-items: center; justify-content: center; gap: 10px;
    border-radius: 2px;
  }

  /* ── Filename bar ── */
  .sp-filename {
    text-align: center;
    font-size: 0.75rem; color: #8a9bac;
    padding: 8px 16px 20px;
    letter-spacing: 0.02em;
  }

  @media (max-width: 600px) {
    .sp-nav { padding: 8px 12px; }
    .sp-body { padding: 12px; }
  }
  </style>
</head>
<body>

<div class="sp-nav">
  <!-- Left: back link -->
  <a class="sp-back" href="/share/<%= token %>">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
    Back to album
  </a>

  <!-- Center: prev / counter / next -->
  <div class="sp-center">
    <% if (prevId) { %>
    <a class="sp-arrow" href="/share/<%= token %>/photo/<%= prevId %>">&#8592; prev</a>
    <% } else { %>
    <span class="sp-arrow-ghost">prev</span>
    <% } %>
    <span class="sp-counter"><%= photoNum %> / <%= total %></span>
    <% if (nextId) { %>
    <a class="sp-arrow" href="/share/<%= token %>/photo/<%= nextId %>">next &#8594;</a>
    <% } else { %>
    <span class="sp-arrow-ghost">next</span>
    <% } %>
  </div>

  <!-- Right: rotate + download -->
  <div class="sp-right">
    <% if (!isVideo) { %>
    <button class="sp-rotate" onclick="rotate(-90)" title="Rotate left">&#8634;</button>
    <button class="sp-rotate" onclick="rotate(90)" title="Rotate right">&#8635;</button>
    <% } %>
    <a class="sp-dl-secondary" href="/share/<%= token %>/original/<%= photo.id %>" download="<%= photo.filename %>">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
      ORIGINAL
    </a>
    <a class="sp-dl" href="/share/<%= token %>/display/<%= photo.id %>" download="<%= photo.filename %>">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
      COMPRESSED
    </a>
  </div>
</div>

<div class="sp-body">
  <% if (isVideo) { %>
  <div class="sp-video-wrap">
    <video class="sp-video" src="/share/<%= token %>/full/<%= photo.id %>" controls preload="metadata" onerror="onVideoError()">
      Your browser does not support HTML5 video.
    </video>
    <div class="sp-overlay" id="video-processing">
      <span style="font-size:1.5rem">&#9200;</span>
      <span style="font-weight:600">Optimizing for web playback&hellip;</span>
      <span style="font-size:0.85rem;opacity:0.75" id="proc-status">Starting&hellip;</span>
    </div>
  </div>
  <% } else { %>
  <img src="/share/<%= token %>/display/<%= photo.id %>"
       alt="<%= photo.filename %>"
       class="sp-img"
       id="share-img">
  <% } %>
</div>

<div class="sp-filename"><%= photo.filename %></div>

<script>
let _rot = 0;
function rotate(deg) {
  _rot = (_rot + deg + 360) % 360;
  const img = document.getElementById('share-img');
  if (img) img.style.transform = `rotate(${_rot}deg)`;
}

document.addEventListener('keydown', e => {
  <% if (prevId) { %>if (e.key === 'ArrowLeft')  location.href = '/share/<%= token %>/photo/<%= prevId %>';<% } %>
  <% if (nextId) { %>if (e.key === 'ArrowRight') location.href = '/share/<%= token %>/photo/<%= nextId %>';<% } %>
});

async function onVideoError() {
  const overlay = document.getElementById('video-processing');
  if (!overlay || overlay.style.display === 'flex') return;
  overlay.style.display = 'flex';
  const statusEl = document.getElementById('proc-status');
  let secs = 0;
  const poll = async () => {
    const r = await fetch('/share/<%= token %>/web-status/<%= photo.id %>');
    const d = await r.json();
    if (d.ready) { statusEl.textContent = 'Done — reloading…'; setTimeout(() => location.reload(), 800); return; }
    secs += 5;
    const m = Math.floor(secs / 60), s = secs % 60;
    statusEl.textContent = `Processing… ${m > 0 ? m + 'm ' : ''}${s}s elapsed`;
    setTimeout(poll, 5000);
  };
  poll();
}
</script>

</body>
</html>
