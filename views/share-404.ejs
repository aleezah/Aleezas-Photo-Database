<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Link not found</title>
  <link rel="stylesheet" href="/static/style.css">
  <style>
    .share-404 {
      max-width: 480px;
      margin: 80px auto;
      padding: 32px 24px;
      text-align: center;
      color: var(--text);
    }
    .share-404-icon { font-size: 3rem; margin-bottom: 16px; }
    .share-404 h1 { font-size: 1.4rem; margin-bottom: 10px; }
    .share-404 p  { color: var(--muted); font-size: 0.95rem; line-height: 1.5; }
  </style>
</head>
<body>
<div class="share-404">
  <div class="share-404-icon">🔗</div>
  <h1>Link not found</h1>
  <p>This share link has expired, been revoked, or never existed.<br>Ask the sender for a new link.</p>
</div>
</body>
</html>
