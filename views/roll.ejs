<%
const breadcrumbs = [
  { label: 'Cameras', url: '/cameras' },
  { label: roll.camera_name, url: `/camera/${roll.camera_id}` },
  { label: rollLeaf(roll.rel_path), url: '' },
];
%>
<%- include('partials/header', { title: rollLeaf(roll.rel_path), page, breadcrumbs, favs: false }) %>

<div class="roll-header">
  <div class="roll-header-info">
    <h1><%= rollLabel(roll.rel_path) || roll.camera_name %></h1>
    <div class="roll-meta-row">
      <% if (roll.year) { %><span class="meta-badge"><%= roll.year %></span><% } %>
      <span class="meta-badge film-stock-badge" id="film-stock-display">
        <%= roll.film_stock || '<em>No film stock set</em>' %>
      </span>
      <span class="meta-badge"><%= photos.length %> photos</span>
    </div>
  </div>
  <div class="roll-header-actions">
    <button class="btn-secondary" id="select-btn" onclick="toggleSelectMode()">Select</button>
    <button class="btn-secondary" onclick="toggleEdit()">Edit details</button>
    <button class="btn-danger-sm" onclick="deleteRoll()">Delete roll</button>
  </div>
</div>

<div class="roll-edit-panel" id="roll-edit" style="display:none">
  <div class="edit-row">
    <label>Film stock</label>
    <input type="text" id="film-input" value="<%= roll.film_stock || '' %>" placeholder="e.g. Kodak Gold 200">
  </div>
  <div class="edit-row">
    <label>Notes</label>
    <textarea id="notes-input" rows="3" placeholder="Add notes about this roll…"><%= roll.notes || '' %></textarea>
  </div>
  <div class="edit-actions">
    <button class="btn-primary" onclick="saveRoll()">Save</button>
    <button class="btn-ghost" onclick="toggleEdit()">Cancel</button>
    <span class="save-status" id="status"></span>
  </div>
</div>

<% if (roll.notes) { %>
<div class="roll-notes-block"><%= roll.notes %></div>
<% } %>

<% if (hiddenCount > 0) { %>
<div class="hidden-banner">
  <span>&#128274; <%= hiddenCount %> hidden photo<%= hiddenCount !== 1 ? 's' : '' %> not shown</span>
  <button class="btn-ghost btn-sm" onclick="toggleHiddenView()">Reveal</button>
</div>
<% } %>

<div class="photo-grid" id="photo-grid">
  <% for (const p of photos) { %>
  <a class="photo-thumb-wrap <%= p.favorite ? 'is-favorite' : '' %> <%= p.hidden ? 'is-hidden' : '' %> <%= p.id === roll.cover_photo_id ? 'is-cover' : '' %>"
     href="/photo/<%= p.id %>"
     data-id="<%= p.id %>">
    <img src="/thumb/<%= p.id %>" alt="<%= p.filename %>" loading="lazy">
    <span class="select-check">&#10003;</span>
    <% if (p.id === roll.cover_photo_id) { %><span class="cover-indicator" title="Roll cover">&#9733;</span><% } %>
    <% if (p.favorite) { %><span class="fav-indicator">♥</span><% } %>
    <% if (p.hidden) { %><span class="hidden-indicator">&#128274;</span><% } %>
    <% if (p.notes) { %><span class="notes-indicator">✎</span><% } %>
  </a>
  <% } %>
</div>

<!-- floating bulk action bar -->
<div class="bulk-bar" id="bulk-bar" style="display:none">
  <span class="bulk-count" id="bulk-count">0 selected</span>
  <button class="bulk-btn" onclick="selectAll()">All</button>
  <div class="bulk-divider"></div>
  <button class="bulk-btn bulk-btn--hide" onclick="bulkDo('hide')">&#128274; Hide</button>
  <button class="bulk-btn" onclick="bulkDo('unhide')">&#128065; Unhide</button>
  <button class="bulk-btn bulk-btn--fav" onclick="bulkDo('favorite')">&#9825; Fav</button>
  <div class="bulk-divider"></div>
  <button class="bulk-btn bulk-btn--delete" onclick="bulkDelete()">&#128465; Delete</button>
  <div class="bulk-divider"></div>
  <button class="bulk-btn bulk-btn--cancel" onclick="toggleSelectMode()">Cancel</button>
</div>

<script>
const ROLL_ID = <%- roll.id %>;
let selectMode = false;
const selected = new Set();

function toggleSelectMode() {
  selectMode = !selectMode;
  const grid = document.getElementById('photo-grid');
  const bar  = document.getElementById('bulk-bar');
  const btn  = document.getElementById('select-btn');
  grid.classList.toggle('select-mode', selectMode);
  bar.style.display  = selectMode ? 'flex' : 'none';
  btn.textContent    = selectMode ? 'Cancel' : 'Select';
  btn.classList.toggle('btn-secondary--active', selectMode);
  if (!selectMode) {
    selected.clear();
    grid.querySelectorAll('.selected').forEach(el => el.classList.remove('selected'));
    updateCount();
  }
}

document.getElementById('photo-grid').addEventListener('click', e => {
  if (!selectMode) return;
  const thumb = e.target.closest('.photo-thumb-wrap');
  if (!thumb) return;
  e.preventDefault();
  const id = parseInt(thumb.dataset.id);
  if (selected.has(id)) { selected.delete(id); thumb.classList.remove('selected'); }
  else                  { selected.add(id);    thumb.classList.add('selected');    }
  updateCount();
});

function selectAll() {
  document.querySelectorAll('#photo-grid .photo-thumb-wrap').forEach(el => {
    selected.add(parseInt(el.dataset.id));
    el.classList.add('selected');
  });
  updateCount();
}

function updateCount() {
  document.getElementById('bulk-count').textContent =
    selected.size === 0 ? 'None selected' : `${selected.size} selected`;
}

async function bulkDo(action) {
  if (!selected.size) return;
  const r = await fetch('/api/photos/bulk-action', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ ids: [...selected], action }),
  });
  if ((await r.json()).ok) location.reload();
}

async function bulkDelete() {
  if (!selected.size) return;
  if (!confirm(`Permanently delete ${selected.size} photo${selected.size !== 1 ? 's' : ''} from disk?\n\nThis cannot be undone.`)) return;
  const r = await fetch('/api/photos/bulk-action', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ ids: [...selected], action: 'delete' }),
  });
  if ((await r.json()).ok) location.reload();
}

async function deleteRoll() {
  const count = document.querySelectorAll('#photo-grid .photo-thumb-wrap').length;
  if (!confirm(`Delete this entire roll?\n\n${count} photos will be permanently removed from disk.\n\nThis cannot be undone.`)) return;
  const r = await fetch(`/api/roll/${ROLL_ID}`, { method: 'DELETE' });
  const d = await r.json();
  if (d.ok) window.location.href = `/camera/${d.cameraId}`;
}

function toggleEdit() {
  const p = document.getElementById('roll-edit');
  p.style.display = p.style.display === 'none' ? 'block' : 'none';
}

async function saveRoll() {
  const film  = document.getElementById('film-input').value.trim();
  const notes = document.getElementById('notes-input').value.trim();
  await Promise.all([
    fetch(`/api/roll/${ROLL_ID}/film_stock`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({film_stock: film}) }),
    fetch(`/api/roll/${ROLL_ID}/notes`,      { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({notes}) }),
  ]);
  document.getElementById('film-stock-display').textContent = film || 'No film stock set';
  document.getElementById('status').textContent = 'Saved ✓';
  setTimeout(() => document.getElementById('status').textContent = '', 2000);
  toggleEdit();
}
</script>

<%- include('partials/footer') %>
