<%- include('partials/header', { title: favs ? 'Favorites' : 'Search', page, breadcrumbs: [], favs }) %>

<div class="page-header">
  <h1><%= favs ? 'Favorites' : 'Search' %></h1>
</div>

<div class="search-tabs">
  <button class="search-tab search-tab--active" id="tab-keyword" onclick="switchTab('keyword')">Photos</button>
  <button class="search-tab" id="tab-albums" onclick="switchTab('albums')">Albums</button>
  <button class="search-tab" id="tab-visual" onclick="switchTab('visual')">Visual Search</button>
</div>

<!-- Keyword search -->
<div id="panel-keyword">
  <form class="search-form" method="get">
    <input class="search-input" type="text" name="q" value="<%= q %>" placeholder="Search notes, camera, film stock…">
    <div class="filter-row">
      <select name="camera">
        <option value="">All cameras</option>
        <% for (const c of allCameras) { %>
        <option value="<%= c.id %>" <%= camera == c.id ? 'selected' : '' %>><%= c.name.replace(/^35mm prints \/ |^Digital \/ /,'') %></option>
        <% } %>
      </select>
      <select name="film">
        <option value="">All film stocks</option>
        <% for (const s of allStocks) { %>
        <option value="<%= s.film_stock %>" <%= film === s.film_stock ? 'selected' : '' %>><%= s.film_stock %></option>
        <% } %>
      </select>
      <select name="year">
        <option value="">All years</option>
        <% for (const y of allYears) { %>
        <option value="<%= y.year %>" <%= year === y.year ? 'selected' : '' %>><%= y.year %></option>
        <% } %>
      </select>
      <select name="tag">
        <option value="">All tags</option>
        <% for (const t of allTags) { %>
        <option value="<%= t.name %>" <%= tag === t.name ? 'selected' : '' %>><%= t.name %></option>
        <% } %>
      </select>
      <label class="fav-check">
        <input type="checkbox" name="favs" value="1" <%= favs ? 'checked' : '' %>> Favorites only
      </label>
      <button class="btn-primary" type="submit">Search</button>
      <a class="btn-ghost" href="/search">Clear</a>
    </div>
  </form>

  <% if (photos.length) { %>
  <%
    const totalPages = Math.ceil(totalCount / pageSize);
    const qs = new URLSearchParams({ q, camera, film, year, tag, favs: favs||'' });
    qs.delete('page');
    const baseQs = qs.toString();
  %>
  <p class="result-count">
    <%= totalCount.toLocaleString() %> photo<%= totalCount !== 1 ? 's' : '' %>
    <% if (totalPages > 1) { %> — page <%= currentPage %> of <%= totalPages %><% } %>
  </p>
  <div class="photo-grid">
    <% for (const p of photos) { %>
    <a class="photo-thumb-wrap <%= p.favorite ? 'is-favorite' : '' %>" href="/photo/<%= p.id %>">
      <img src="/thumb/<%= p.id %>" alt="<%= p.filename %>" loading="lazy">
      <div class="thumb-overlay">
        <span><%= p.camera_name.replace(/^35mm prints \/ |^Digital \/ /,'') %></span>
        <% if (p.film_stock) { %><span><%= p.film_stock %></span><% } %>
      </div>
      <% if (p.favorite) { %><span class="fav-indicator">♥</span><% } %>
    </a>
    <% } %>
  </div>
  <% if (totalPages > 1) { %>
  <div class="pagination">
    <% if (currentPage > 1) { %>
    <a class="page-btn" href="/search?<%= baseQs %>&page=<%= currentPage - 1 %>">← Prev</a>
    <% } %>
    <span class="page-info"><%= currentPage %> / <%= totalPages %></span>
    <% if (currentPage < totalPages) { %>
    <a class="page-btn" href="/search?<%= baseQs %>&page=<%= currentPage + 1 %>">Next →</a>
    <% } %>
  </div>
  <% } %>
  <% } else if (q || camera || film || year || tag || favs) { %>
  <p class="no-results">No photos found.</p>
  <% } %>
</div>

<!-- Albums search -->
<div id="panel-albums" style="display:none">
  <div class="album-search-form">
    <input class="search-input" type="text" id="album-input" placeholder="Search by name, film stock, notes…">
    <div class="filter-row" style="margin-top:8px">
      <select id="album-camera">
        <option value="">All cameras</option>
        <% for (const c of allCameras) { %>
        <option value="<%= c.id %>"><%= c.name.replace(/^35mm prints \/ |^Digital \/ /,'') %></option>
        <% } %>
      </select>
      <select id="album-year">
        <option value="">All years</option>
        <% for (const y of allYears) { %>
        <option value="<%= y.year %>"><%= y.year %></option>
        <% } %>
      </select>
      <button class="btn-primary" onclick="runAlbumSearch()">Search</button>
      <button class="btn-ghost" onclick="clearAlbumSearch()">Clear</button>
    </div>
  </div>
  <div id="album-status" class="visual-status" style="display:none">Searching…</div>
  <div id="album-results" class="roll-grid" style="margin-top:20px"></div>
</div>

<!-- Visual search -->
<div id="panel-visual" style="display:none">
  <div class="visual-search-box">
    <input class="search-input" type="text" id="visual-input"
           placeholder="Describe what you're looking for… e.g. cat, red dress, beach, birthday cake">
    <button class="btn-primary" onclick="runVisualSearch()">Search</button>
  </div>
  <div class="visual-tag-suggestions">
    <span class="suggest-label">Try:</span>
    <% const suggestions = ['cat','dog','dress','hijab','beach','snow','birthday','wedding','food','night','selfie','group photo','sunset','city']; %>
    <% for (const s of suggestions) { %>
    <button class="suggest-chip" onclick="quickSearch('<%= s %>')"><%= s %></button>
    <% } %>
  </div>
  <div id="visual-status" class="visual-status" style="display:none">Searching…</div>
  <div id="visual-results" class="photo-grid" style="margin-top:20px"></div>
  <div id="visual-more" style="display:none;text-align:center;margin-top:16px">
    <button class="btn-ghost" onclick="loadMoreVisual()">Load more</button>
  </div>
</div>

<script>
const TABS = ['keyword', 'albums', 'visual'];
function switchTab(tab) {
  for (const t of TABS) {
    document.getElementById('panel-' + t).style.display = t === tab ? '' : 'none';
    document.getElementById('tab-' + t).classList.toggle('search-tab--active', t === tab);
  }
  if (tab === 'albums' && !document.getElementById('album-results').innerHTML) {
    runAlbumSearch();
  }
}

function rollLeaf(rel) {
  const parts = (rel || '').split(/[/\\/]/);
  return parts[parts.length - 1] || rel;
}

async function runAlbumSearch() {
  const q      = document.getElementById('album-input').value.trim();
  const camera = document.getElementById('album-camera').value;
  const year   = document.getElementById('album-year').value;
  const status = document.getElementById('album-status');
  const grid   = document.getElementById('album-results');

  status.style.display = '';
  status.textContent = 'Searching…';
  grid.innerHTML = '';

  const qs = new URLSearchParams({ q, camera, year });
  const r = await fetch('/api/search/rolls?' + qs);
  const rolls = await r.json();

  status.style.display = 'none';
  if (!rolls.length) {
    grid.innerHTML = '<p class="no-results">No albums found.</p>';
    return;
  }

  grid.innerHTML = rolls.map(roll => {
    const name       = rollLeaf(roll.rel_path);
    const camLabel   = (roll.camera_name || '').replace(/^35mm prints \/ |^Digital \/ /, '');
    const thumb      = roll.preview_id ? `<img src="/thumb/${roll.preview_id}" alt="" loading="lazy">` : '';
    const filmBadge  = roll.film_stock ? `<div class="roll-film">${roll.film_stock}</div>` : '';
    const dateLine   = roll.date_label || roll.year || '';
    return `
      <a class="roll-card" href="/roll/${roll.id}">
        <div class="roll-thumb">${thumb}</div>
        <div class="roll-info">
          <div class="roll-camera">${camLabel}</div>
          <div class="roll-date">${name}</div>
          ${dateLine ? `<div class="roll-count">${dateLine}</div>` : ''}
          ${filmBadge}
          <div class="roll-count">${roll.photo_count} photo${roll.photo_count !== 1 ? 's' : ''}</div>
        </div>
      </a>`;
  }).join('');
}

function clearAlbumSearch() {
  document.getElementById('album-input').value = '';
  document.getElementById('album-camera').value = '';
  document.getElementById('album-year').value = '';
  runAlbumSearch();
}

document.getElementById('album-input').addEventListener('keydown', e => {
  if (e.key === 'Enter') runAlbumSearch();
});

function quickSearch(q) {
  document.getElementById('visual-input').value = q;
  runVisualSearch();
}

let _visualPage = 1;
let _visualQuery = '';

async function runVisualSearch() {
  _visualQuery = document.getElementById('visual-input').value.trim();
  if (!_visualQuery) return;
  _visualPage = 1;
  document.getElementById('visual-results').innerHTML = '';
  document.getElementById('visual-more').style.display = 'none';
  await fetchVisualPage();
}

async function loadMoreVisual() {
  _visualPage++;
  await fetchVisualPage();
}

async function fetchVisualPage() {
  const status = document.getElementById('visual-status');
  status.style.display = '';
  status.textContent = 'Searching…';
  try {
    const r = await fetch('/api/visual-search', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query: _visualQuery, page: _visualPage }),
    });
    const data = await r.json();
    const photos = Array.isArray(data) ? data : (data.photos || []);
    const hasMore = data.hasMore || false;
    status.style.display = 'none';
    const grid = document.getElementById('visual-results');
    if (!photos.length && _visualPage === 1) {
      grid.innerHTML = '<p class="no-results">No matching photos found.</p>';
      return;
    }
    grid.innerHTML += photos.map(p => `
      <a class="photo-thumb-wrap${p.hidden ? ' is-hidden' : ''}${p.favorite ? ' is-favorite' : ''}"
         href="/photo/${p.id}">
        <img src="/thumb/${p.id}" alt="${p.filename}" loading="lazy">
        ${p.favorite ? '<span class="fav-indicator">♥</span>' : ''}
      </a>
    `).join('');
    document.getElementById('visual-more').style.display = hasMore ? '' : 'none';
  } catch(e) {
    document.getElementById('visual-status').textContent = 'Error: ' + e.message;
  }
}

document.getElementById('visual-input').addEventListener('keydown', e => {
  if (e.key === 'Enter') runVisualSearch();
});
</script>

<%- include('partials/footer') %>
